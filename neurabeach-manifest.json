{
  "manifest_version": "1.0.0",
  "name": "neurabinder",
  "display_name": "NeuraBinder",
  "version": "0.3.0",
  "description": "BCI-inspired TCG binder with NeuralBridge integration (simulator or multi-client). Computer-side web app — not implant software.",
  "safety_class": "computer_side",
  "runtime": "web",
  "inputs": [
    "class_label",
    "switch_binary",
    "velocity_2d",
    "synthetic"
  ],
  "outputs": ["ui_only"],
  "hardware": [
    "synthetic",
    "generic_intent",
    "websocket_intent",
    "neuralink_sdk_future"
  ],
  "permissions": ["none"],
  "dof": "switch_2_4",
  "latency_class": "interactive",
  "platforms": ["web", "macos", "windows", "linux"],
  "calibration": "optional",
  "entrypoint": "https://neura-binder.vercel.app/demo",
  "repository": "https://github.com/pileofflapjacks1/NeuraBinder",
  "suite_role": "app",
  "depends_on": ["neuralbridge"],
  "banned_claims": true
}
