{
  "manifest_version": "1.0.0",
  "name": "neurabinder",
  "display_name": "NeuraBinder",
  "version": "0.2.2",
  "description": "BCI-inspired TCG binder: showcase path, intent record/replay, /demo + /a11y, NeuralBridge-shaped intent socket. Computer-side web app — not implant software.",
  "safety_class": "computer_side",
  "runtime": "web",
  "inputs": [
    "class_label",
    "switch_binary",
    "velocity_2d",
    "synthetic"
  ],
  "outputs": ["ui_only"],
  "hardware": [
    "synthetic",
    "generic_intent",
    "websocket_intent",
    "neuralink_sdk_future"
  ],
  "permissions": ["none"],
  "dof": "switch_2_4",
  "latency_class": "interactive",
  "platforms": ["web", "macos", "windows", "linux"],
  "calibration": "optional",
  "entrypoint": "pnpm dev",
  "repository": "https://github.com/pileofflapjacks1/NeuraBinder",
  "banned_claims": true
}
