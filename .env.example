# Optional Postgres (Supabase / local). Without this, the app runs fully on seed + localStorage.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neurabinder

# Optional Grok / xAI — enhances /api/ai/query; local NL always works without it
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Client: set true only if you want the command bar to call the cloud AI route
NEXT_PUBLIC_ENABLE_CLOUD_AI=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
